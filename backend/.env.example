# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upiq
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/upiq

# Server Port
SERVER_PORT=8080

# Spring Active Profile (local / prod / research)
SPRING_PROFILES_ACTIVE=local

# Security & JWT
JWT_SECRET=your_base64_or_hex_encoded_secret_key_min_256_bits_here
JWT_EXPIRATION=86400000
